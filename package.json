{
  "name": "sutra",
  "version": "0.1.0",
  "description": "Zero-to-code QA pipeline: turns a BRD or user story into Xray-linked test cases, self-grounded Playwright + Cucumber automation (via Playwright MCP), sandboxed execution, and results written back to Jira — with full lineage from requirement to result.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "pipeline": "tsx src/orchestrator/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.208",
    "@playwright/test": "^1.61.1",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "execa": "^9.6.1",
    "graphql-request": "^7.4.0",
    "mammoth": "^1.12.0",
    "pactum": "^3.9.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.61.1",
    "playwright-bdd": "^9.2.0",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.78",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.1.1",
    "allure-playwright": "^3.10.2",
    "archiver": "^8.0.0",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
