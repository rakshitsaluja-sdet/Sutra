# --- Optional: leave blank to use an existing OAuth session (e.g. a Claude Code login) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Jira / Xray Cloud (optional — leave blank to run in stub mode) ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
XRAY_PROJECT_KEY=
# 'stub' | 'live' — auto-forced to 'stub' if any Xray var above is missing
XRAY_MODE=stub

# --- Test-management backend selector ---
# stub (default) | xray | kiwi. If unset, derived from XRAY_MODE (live->xray).
# Set to 'kiwi' to run the pipeline against a self-hosted Kiwi TCMS instead of Xray.
TCMS_BACKEND=

# --- Kiwi TCMS (Case 2: free, self-hosted alternative to Xray) ---
# Spin it up with docker/kiwi/docker-compose.yml, then set the admin creds you
# created during `manage.py initial_setup`.
KIWI_BASE_URL=https://localhost
KIWI_USERNAME=
KIWI_PASSWORD=
# Kiwi Product name to file everything under (defaults to XRAY_PROJECT_KEY or 'Sutra').
KIWI_PRODUCT=
# Kiwi on localhost uses a self-signed cert; 'true' skips verifying it. Set
# 'false' only for a Kiwi behind a real, trusted certificate.
KIWI_TLS_INSECURE=true

# --- Playwright MCP (stages 4 & 6 only, never used for sandbox execution) ---
PLAYWRIGHT_MCP_HEADLESS=true

# --- Sandbox ---
# Pin an exact tag — check https://mcr.microsoft.com/en-us/product/playwright/tags
# for the tag matching the installed @playwright/test version before running.
SANDBOX_DOCKER_IMAGE=mcr.microsoft.com/playwright:v1.61.1-noble
SANDBOX_TIMEOUT_MS=120000

# --- Target application under test (Milestone 1 fixture) ---
TARGET_BASE_URL=https://the-internet.herokuapp.com

# --- Optional: an existing test account, used by the Script Generator for real
# login flows instead of guessing credentials. Never used to register new accounts. ---
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
