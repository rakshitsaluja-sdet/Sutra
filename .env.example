# --- Optional: leave blank to use an existing OAuth session (e.g. a Claude Code login) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Jira / Xray Cloud (optional — leave blank to run in stub mode) ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
XRAY_PROJECT_KEY=
# 'stub' | 'live' — auto-forced to 'stub' if any Xray var above is missing
XRAY_MODE=stub

# --- Playwright MCP (stages 4 & 6 only, never used for sandbox execution) ---
PLAYWRIGHT_MCP_HEADLESS=true

# --- Sandbox ---
# Pin an exact tag — check https://mcr.microsoft.com/en-us/product/playwright/tags
# for the tag matching the installed @playwright/test version before running.
SANDBOX_DOCKER_IMAGE=mcr.microsoft.com/playwright:v1.61.1-noble
SANDBOX_TIMEOUT_MS=120000

# --- Target application under test (Milestone 1 fixture) ---
TARGET_BASE_URL=https://the-internet.herokuapp.com
